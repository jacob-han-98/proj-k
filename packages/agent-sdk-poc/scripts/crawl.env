# Klaud 크롤 파이프라인 설정 (AI-TEST-02) — systemd EnvironmentFile 겸용
# 비밀(P4 비번/Confluence 토큰)은 여기 두지 않는다.
#   - P4 자격: /home/jacob/repos/proj-k/scripts/.env (P4PORT/P4USER/P4PASSWD/P4CLIENT)
#   - Confluence 자격: packages/confluence-downloader/.env
#   - Bedrock: packages/xlsx-extractor/.env (AWS_BEARER_TOKEN_BEDROCK)
# klaud-crawl 가 위 파일들을 자동 로드한다.

# ── 데이터 루트 (output 심볼릭 링크 타겟) ──
PROJK_DATA_ROOT=/home/jacob/proj-k-data

# ── 크롤 런타임 venv ──
PROJK_CRAWL_PYTHON=/home/jacob/repos/proj-k/packages/xlsx-extractor/.venv/bin/python

# ── OnlyOffice DS (GDD 변환 capture 백엔드) ──
PROJK_ONLYOFFICE_URL=http://localhost:8080

# ════════════════════════════════════════════════════════════
# 3개 파이프라인 (사용자 확정 2026-06-08)
# ════════════════════════════════════════════════════════════
#
# [1] Confluence — wiki 기획 (텍스트). 전체 ~1250p. 이미지는 401 로 미수집(text-only).
#     root page id 는 confluence-downloader/.env 의 CONFLUENCE_ROOT_PAGE_ID
#
# [2] p4 GDD 기획서 — Design/7_System + Design/8_Contents 만 (★ 7,8 외 변환 금지)
#     → p4 sync → xlsx-extractor OnlyOffice 변환 → output/{7_System,8_Contents}/ → 요약
PROJK_GDD_DEPOT_7=//main/ProjectK/Design/7_System/...
PROJK_GDD_DEPOT_8=//main/ProjectK/Design/8_Contents/...
PROJK_GDD_LOCAL=/home/jacob/p4sync/Design
PROJK_GDD_OUTPUT=/home/jacob/proj-k-data/xlsx-extractor/output
#
# [3] p4 수치 테이블 (DataSheet) — Resource/design → game_data.db (data-pipeline)
#     Vision 불필요(결정적 파싱). MCP query_game_table 이 읽는 ~/.qna-poc-gamedata/game_data.db
PROJK_DATASHEET_DEPOT=//main/ProjectK/Resource/design/...
PROJK_DATASHEET_LOCAL=/home/jacob/p4sync/Resource/design

# ── cron-tick 의 P4 변경감지 대상 (GDD 만; DataSheet 는 별도 ingest) ──
P4_DEPOT_PATHS=//main/ProjectK/Design/7_System/...,//main/ProjectK/Design/8_Contents/...
